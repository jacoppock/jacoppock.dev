---
import "@fontsource-variable/atkinson-hyperlegible-next";
import "@fontsource-variable/atkinson-hyperlegible-mono";
import "../styles/global.css";
import { PAGES, ogPath } from "../lib/pages";
import { SHOW_UNFINISHED } from "../lib/env";
import { getCollection } from "astro:content";
const hasWriting = (await getCollection("writing")).some((e) => SHOW_UNFINISHED || e.data.status !== "draft");

interface Props { title?: string; description?: string }
const {
  title,
  description = "James Coppock is an applied ML scientist who builds systems that turn messy healthcare signals, from heartbeats and MRIs to payer contracts, into decisions people can trust.",
} = Astro.props;
const fullTitle = title ? `${title} | James Coppock` : "James Coppock, applied ML scientist";
const navAll = [
  ["/work", "Work"], ["/lab", "Lab"], ["/research", "Research"],
  ["/writing", "Writing"], ["/life", "Off the clock"], ["/about", "About"],
];
const nav = navAll.filter(([href]) => hasWriting || href !== "/writing");
const here = Astro.url.pathname.replace(/\/$/, "") || "/";
const ogImage = new URL(PAGES[here] ? ogPath(here) : ogPath("/"), Astro.site);
const umamiId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID;
const person = {
  "@context": "https://schema.org", "@type": "Person",
  name: "James A. Coppock", url: "https://jacoppock.dev",
  jobTitle: "Manager, AI/ML Applied Science", worksFor: { "@type": "Organization", name: "Infinia ML" },
  alumniOf: { "@type": "CollegeOrUniversity", name: "Duke University" },
  sameAs: ["https://github.com/jacoppock", "https://scholar.google.com/citations?user=aUYi9_IAAAAJ"],
};
---
<!doctype html>
<html lang="en" data-env={SHOW_UNFINISHED ? "dev" : "prod"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" href="/favicon.png" />
    <meta name="theme-color" content="#eef2e7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#17212b" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <script is:inline>
      // Analytics events: sent once per page view, and only if Umami is configured.
      (() => { const sent = new Set(); window.jtrack = (n) => { if (sent.has(n)) return; sent.add(n); try { window.umami && window.umami.track(n); } catch (e) {} }; })();
    </script>
    {umamiId && <script defer src="https://cloud.umami.is/script.js" data-website-id={umamiId} data-domains="jacoppock.dev,www.jacoppock.dev" />}
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
  </head>
  <body>
    <div class="frame">
      <header class="site-header">
        <a class="site-name" href="/" aria-current={here === "/" ? "page" : undefined}>James Coppock</a>
        <nav class="site-nav" aria-label="Main">
          {nav.map(([href, label]) => <a href={href} aria-current={here.startsWith(href) ? "page" : undefined}>{label}</a>)}
        </nav>
      </header>
      <main class="page"><slot /></main>
      <footer class="site-footer">
        <span>Durham, North Carolina</span>
        <nav aria-label="Footer">
          <a href="/now">Now</a><a href="/changelog">Changelog</a><a href="/cv">CV</a><a href="/contact">Contact</a>
        </nav>
      </footer>
    </div>
  </body>
</html>
