---
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";
import { isVisible } from "../../lib/published";
export async function getStaticPaths() {
  const items = (await getCollection("work")).filter(isVisible);
  return items.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---
<Base title={entry.data.title} description={entry.data.summary}>
  {entry.data.status === "draft" && <p class="draft">Draft: awaiting employer approval. This page is excluded from production builds.</p>}
  <p class="note">{entry.data.org}<br />{entry.data.years}</p>
  <h1>{entry.data.title}</h1>
  <p class="role">{entry.data.role}</p>
  <div class="prose"><Content /></div>
  <p class="back"><a href="/work">All work</a></p>
</Base>

<style>
  .role { font-size: var(--step-1); color: var(--ink-soft); }
  .back { margin-top: 3rem; }
</style>
