---
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";
import { isVisible } from "../../lib/published";
import StepFlow from "../../components/StepFlow.astro";
import PpgFigure from "../../components/PpgFigure.astro";
import { expandFigures } from "../../lib/figures";
export async function getStaticPaths() {
  const items = (await getCollection("work")).filter(isVisible);
  return items.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const html = entry.rendered?.html;
const hasFigures = !!html?.includes("data-fig=");
---
<Base title={entry.data.title} description={entry.data.summary}>
  {entry.data.status === "draft" && <p class="draft">Draft: awaiting employer approval. This page is excluded from production builds.</p>}
  <p class="note">{entry.data.org}<br />{entry.data.years}</p>
  <h1>{entry.data.title}</h1>
  <p class="role">{entry.data.role}</p>
  {entry.data.flow.length > 0 && (
    <StepFlow steps={entry.data.flow} caption={entry.data.flowCaption}
      link={entry.id === "contractiq" ? { href: "/lab/contract", label: "Open the explorer." }
        : entry.id === "duke-imaging" ? { href: "/lab/disc", label: "Scrub through one disc." } : undefined} />
  )}
  {entry.data.figure === "ppg" && <PpgFigure />}
  {hasFigures ? <div class="prose" set:html={expandFigures(html!)} /> : <div class="prose"><Content /></div>}
  <p class="back"><a href="/work">All work</a></p>
</Base>

<style>
  .role { font-size: var(--step-1); color: var(--ink-soft); }
  .back { margin-top: 3rem; }
</style>
