---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";
import { isVisible } from "../../lib/published";
const items = (await getCollection("work")).filter(isVisible).sort((a, b) => a.data.order - b.data.order);
---
<Base title="Work">
  <h1>Work</h1>
  <p class="lede">Each case study follows the same shape: the problem, my role, the approach, the outcome, and what I'd do differently.</p>
  {items.map((w) => (
    <>
      <p class="note">{w.data.years}<br />{w.data.org}</p>
      <article class="entry">
        <h2><a href={`/work/${w.id}`}>{w.data.title}</a></h2>
        {w.data.status === "draft" && <p class="draft">Draft, hidden on the live site until approved.</p>}
        <p>{w.data.summary}</p>
      </article>
    </>
  ))}
</Base>
<style>
  .lede { font-size: var(--step-1); }
  .entry h2 { margin-top: 0; font-size: var(--step-1); }
  .entry { margin-bottom: 1.75rem; }
  @media (max-width: 63.99rem) { .note { margin: 1.5rem 0 0.25rem; } }
</style>
