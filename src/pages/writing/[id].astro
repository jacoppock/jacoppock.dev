---
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";
import { SHOW_UNFINISHED } from "../../lib/env";
export async function getStaticPaths() {
  const items = (await getCollection("writing")).filter((e) => SHOW_UNFINISHED || e.data.status !== "draft");
  return items.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const date = new Date(entry.data.date + "T12:00:00").toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" });
---
<Base title={entry.data.title} description={entry.data.summary}>
  {entry.data.status === "draft" && <p class="draft">Draft for review. Hidden on the live site until its status is set to published.</p>}
  <p class="note">{date}</p>
  <article class="essay">
    <h1>{entry.data.title}</h1>
    <p class="dek">{entry.data.summary}</p>
    <Content />
  </article>
  <p class="back"><a href="/writing">All writing</a></p>
</Base>
<style>
  .essay h1 { margin-bottom: 0.3em; }
  .dek { font-size: var(--step-1); color: var(--ink-soft); line-height: 1.45; margin-bottom: 2rem; }
  .essay :global(p), .essay :global(li) { font-size: 1.125rem; line-height: 1.7; }
  .essay :global(h2) { font-size: var(--step-1); margin-top: 2.2em; }
  .essay :global(strong) { font-weight: 750; }
  .back { margin-top: 3rem; }
</style>
